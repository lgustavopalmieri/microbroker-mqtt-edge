# ── Broker TCP ────────────────────────────────────────
BROKER_HOST=0.0.0.0
BROKER_PORT=1883

# ── HTTP API (audit + OEE availability) ───────────────
BROKER_HTTP_PORT=8080

# ── Authentication (required) ──────────────────────────
BROKER_USERNAME=machine01
BROKER_PASSWORD=secret123

# ── Allowed topics (1-5, comma-separated) ─────────────
# Topics are by data type, not per machine (scalable to full OEE within the 5-topic cap).
# machine/state carries state_change events consumed by the OEE availability module.
BROKER_TOPICS=machine/state,machine/production,machine/cycle,machine/quality,machine/alarm

# ── Limits ─────────────────────────────────────────────
BROKER_MAX_CLIENTS=5
BROKER_QUEUE_BUFFER_SIZE=10000

# ── SQLite ─────────────────────────────────────────────
BROKER_DB_PATH=/data/broker.db

# ── Timezone ───────────────────────────────────────────
BROKER_TIMEZONE=America/Sao_Paulo

# ── OEE / Availability (optional) ─────────────────────
BROKER_OEE_ENABLED=true
BROKER_OEE_STATE_TOPIC=machine/state   # must be one of BROKER_TOPICS
BROKER_OEE_TICK_INTERVAL=1s            # live recompute cadence (Go duration)
BROKER_OEE_WS_ENABLED=true
BROKER_OEE_SHIFTS_PATH=                # path to shifts JSON file; empty = no seeding
